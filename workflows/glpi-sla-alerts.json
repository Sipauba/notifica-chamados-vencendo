    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n  g.id, \n  g.name,\n  DATE_FORMAT(g.time_to_resolve, '%H:%i') AS hora_fim_prazo\nFROM \n  glpi_tickets g\nWHERE \n  g.status IN (1, 2)\n  AND g.time_to_resolve BETWEEN \n      DATE_ADD(NOW(), INTERVAL 60 MINUTE)\n      AND DATE_ADD(NOW(), INTERVAL 65 MINUTE);",
