        "jsCode": "let mensagemFinal = '🚨 Chamado(s) vencendo em 1 hora: 🚨\\n\\n';\n\nfor (const item of items) {\n  const numero = item.json.id;\n  const titulo = item.json.name;\n  const hora = item.json.hora_fim_prazo;\n  mensagemFinal += `Nº ${numero} (${hora}): ${titulo}\\n`;\n}\n\n// Retorne a string sem stringify\nreturn [{\n  json: {\n    resultado: mensagemFinal\n  }\n}];\n"
      },
